# Пример для поддержки Hostline. Не загружайте этот файл как страницу сайта.
# Пути root и сертификатов должен подставить Hostline после выпуска SSL.

server {
    listen 80;
    server_name xn--b1agipga6ae5i.com www.xn--b1agipga6ae5i.com;

    return 301 https://xn--b1agipga6ae5i.com$request_uri;
}

